OPENAI_API_KEY=
EPOCH_LLM_MODEL=gpt-4o-mini
EPOCH_LLM_BASE_URL=
EPOCH_EMBED_API_KEY=
EPOCH_EMBED_BASE_URL=
EPOCH_EMBED_MODEL=text-embedding-v4
EPOCH_EMBED_DIMENSIONS=1024
EPOCH_DB_PATH=./data/eviepoch-v1.sqlite3
# Required by the standard production compose stack. Use URL-safe passwords.
EPOCH_POSTGRES_PASSWORD=
EPOCH_APP_DB_PASSWORD=
EPOCH_PG_HNSW_EF_SEARCH=100
EPOCH_PG_HNSW_MAX_SCAN_TUPLES=20000
EPOCH_SOURCE_CHUNK_BYTES=1800
EPOCH_ALLOW_SQLITE=0
EPOCH_AUTH_SCHEME=bearer
EPOCH_AUTH_TOKEN=
EPOCH_RECALL_WEIGHT=0.5
EPOCH_RETURN_LIMIT=100
EPOCH_CHAR_BUDGET=400000
EPOCH_WINDOW_RADIUS=1
EPOCH_RAW_FIRST=1
EPOCH_EXTRACT_FACTS=1
EPOCH_RECALL_QUERY=1
EPOCH_ANSWER_INPUT_TOKENS=117760
EPOCH_ANSWER_PROMPT_TOKENS=1024
EPOCH_ANSWER_ITEM_TOKENS=20
EPOCH_TOKEN_SAFETY=1.15

# Full is the source-backed lifecycle pipeline. hybrid and b0 are experimental controls.
EPOCH_PROFILE=full
EPOCH_MODEL_POLICY=competition
EPOCH_SELECTOR=beam
# Compose injects the PostgreSQL service URL. For direct local runs set this explicitly,
# or set EPOCH_ALLOW_SQLITE=1 to opt into SQLite verification.
EPOCH_DATABASE_URL=
EPOCH_CANDIDATE_LIMIT=120
EPOCH_GRAPH_DEPTH=3
EPOCH_GRAPH_BUDGET=512
EPOCH_GRAPH_RETRIEVAL_ENABLED=1
EPOCH_BEAM_WIDTH=12
EPOCH_GAP_ITERATIONS=1
EPOCH_RELATIONS=1
EPOCH_CONSOLIDATION=1
EPOCH_REFLECTION=1
EPOCH_PROOF_BINDING=1
EPOCH_SEARCH_CONSISTENCY_RETRIES=2
EPOCH_TEMPORAL_ANCHORS=1
EPOCH_STRUCTURED_INGEST=1
EPOCH_STATE_PROJECTION=1
EPOCH_COVERAGE=1
EPOCH_EPISODE_NAVIGATION=1
EPOCH_DISCLOSURE=1
EPOCH_SUPPORT_AUDIT=1
EPOCH_CONTEXT_EXPANSION=1
EPOCH_BINDER_WINDOW_CHARS=3200
EPOCH_COVERAGE_SOURCE_LIMIT=32
EPOCH_ADD_CONCURRENCY=16
EPOCH_SEARCH_CONCURRENCY=32
EPOCH_EXTRACTION_CHARS=24000
EPOCH_EXTRACTION_INPUT_TOKENS=24000
EPOCH_EXTRACTION_SPLIT_DEPTH=4
EPOCH_EXTRACTION_MAX_CALLS=128
EPOCH_EXTRACTION_DEADLINE_SECONDS=300
# Workbench may display full source text. Enable only for public/self-authored research.
EPOCH_WORKBENCH=0
# Independent Qwen3-Reranker-0.6B sidecar. Docker Compose uses the service name;
# local API runs use the loopback default and can start the sidecar on port 8090.
EPOCH_RERANK_ENABLED=1
EPOCH_RERANK_URL=http://127.0.0.1:8090/rerank
EPOCH_RERANK_TIMEOUT_SECONDS=20
EPOCH_RERANK_CANDIDATE_LIMIT=120
EPOCH_RERANK_CATEGORY_QUOTA=8
EPOCH_RERANK_SEGMENT_CHARS=4000
EPOCH_RERANK_MAX_SEGMENTS=3
EPOCH_RERANK_MODEL_PATH=./models/Qwen3-Reranker-0.6B
EPOCH_RERANK_BATCH_SIZE=8
EPOCH_RERANK_BIND=127.0.0.1
EPOCH_RERANK_PORT=8090
# Developer-only DeepSeek switch is explicit: experiments/provider_smoke.py --deepseek.
# The existing DEEPSEEK_API_KEY and DASHSCOPE_API_KEY remain in the local .env.
EPOCH_RESEARCH_LLM_MODEL=deepseek-flash
EPOCH_RESEARCH_LLM_BASE_URL=https://api.deepseek.com
