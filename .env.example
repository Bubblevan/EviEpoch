OPENAI_API_KEY=
EPOCH_LLM_MODEL=gpt-4o-mini
EPOCH_LLM_BASE_URL=
EPOCH_EMBED_API_KEY=
EPOCH_EMBED_BASE_URL=
EPOCH_EMBED_MODEL=text-embedding-v4
EPOCH_EMBED_DIMENSIONS=1024
EPOCH_DB_PATH=./data/eviepoch-v1.sqlite3
EPOCH_AUTH_SCHEME=bearer
EPOCH_AUTH_TOKEN=
EPOCH_RECALL_WEIGHT=0.5
EPOCH_RETURN_LIMIT=100
EPOCH_CHAR_BUDGET=400000
EPOCH_WINDOW_RADIUS=1
EPOCH_RAW_FIRST=1
EPOCH_EXTRACT_FACTS=1
EPOCH_RECALL_QUERY=1
EPOCH_ANSWER_INPUT_TOKENS=117760
EPOCH_ANSWER_PROMPT_TOKENS=1024
EPOCH_ANSWER_ITEM_TOKENS=20
EPOCH_TOKEN_SAFETY=1.15

# Full is the source-backed lifecycle pipeline. hybrid and b0 are experimental controls.
EPOCH_PROFILE=full
EPOCH_MODEL_POLICY=competition
EPOCH_SELECTOR=beam
# Empty URL uses the local SQLite verifier. Deploy with compose.postgres.yaml for PostgreSQL.
EPOCH_DATABASE_URL=
EPOCH_CANDIDATE_LIMIT=120
EPOCH_GRAPH_DEPTH=3
EPOCH_GRAPH_BUDGET=512
EPOCH_BEAM_WIDTH=12
EPOCH_GAP_ITERATIONS=1
EPOCH_RELATIONS=1
EPOCH_CONSOLIDATION=1
EPOCH_REFLECTION=1
EPOCH_PROOF_BINDING=1
EPOCH_ADD_CONCURRENCY=16
EPOCH_SEARCH_CONCURRENCY=32
EPOCH_EXTRACTION_CHARS=24000
EPOCH_EXTRACTION_INPUT_TOKENS=24000
EPOCH_EXTRACTION_SPLIT_DEPTH=4
EPOCH_EXTRACTION_MAX_CALLS=128
EPOCH_EXTRACTION_DEADLINE_SECONDS=300
# Workbench may display full source text. Enable only for public/self-authored research.
EPOCH_WORKBENCH=0
# Optional cross-encoder endpoint: {query,documents:[{id,text}]} -> {scores:[{id,score}]}.
EPOCH_RERANK_URL=
# Developer-only DeepSeek switch is explicit: experiments/provider_smoke.py --deepseek.
# The existing DEEPSEEK_API_KEY and DASHSCOPE_API_KEY remain in the local .env.
EPOCH_RESEARCH_LLM_MODEL=deepseek-flash
EPOCH_RESEARCH_LLM_BASE_URL=https://api.deepseek.com
